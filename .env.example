VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudinary - SERVER-SIDE ONLY (used by api/cloudinary-sign.js). Never prefix with VITE_.
# Set these in the Vercel project environment variables, not in client code.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Optional: comma-separated emails allowed to upload (in addition to being logged in).
# ADMIN_EMAILS=admin@example.com

# SERVER-SIDE ONLY (used by api/submit-lead.js). Bypasses RLS - never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Ads / tracking (public IDs, safe in the browser). Nothing loads until the visitor accepts cookies.
VITE_GTM_ID=GTM-XXXXXXX
# Cloudflare Turnstile CAPTCHA: site key is public, secret is SERVER-SIDE ONLY (api/submit-lead.js)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Self-hosted proof-of-work CAPTCHA (no account needed). Any long random string, SERVER-SIDE ONLY.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTCHA_SECRET=
